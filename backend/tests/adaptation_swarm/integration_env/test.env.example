# PLANTILLA de variables del entorno de pruebas de integración de adaptation_swarm. Solo valores FICTICIOS de prueba.
# Copia este archivo a `test.env` (no se versiona: está en .gitignore) y cárgalo con:
#     set -a; source backend/tests/adaptation_swarm/integration_env/test.env; set +a
# Estas variables tienen prioridad sobre backend/.env (el .env de desarrollo no se lee ni se modifica).

SWARM_TEST_PG_PASSWORD=swarm_test_pw
DATABASE_URL=postgresql+psycopg://swarm_test:swarm_test_pw@127.0.0.1:55432/swarm_test
SWARM_REDIS_URL=redis://127.0.0.1:56379/0

ENV=development
DEBUG=false
LOG_LEVEL=WARNING
SECRET_KEY=valor-ficticio-solo-para-pruebas-de-integracion-0123456789
SWARM_API_KEY=valor-ficticio-swarm-api-key

# Sin servicios externos: claves vacías y OpenAI apuntando a un puerto local muerto, de modo que cualquier llamada accidental
# falle en local y no salga a Internet ni tenga coste.
OPENAI_API_KEY=
TAVILY_API_KEY=
HF_TOKEN=
OLLAMA_URL=
OPENAI_BASE_URL=http://127.0.0.1:1/v1

# Opcional: la biblioteca M1 (con audio) se lee por defecto de datasets/adaptation_library/. Para apuntar a otra copia, en SOLO LECTURA:
# SWARM_LIBRARY_ROOT=/ruta/absoluta/a/adaptation_library
